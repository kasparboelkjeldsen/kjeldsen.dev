{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:36323",
      "sslPort": 44375
    }
  },
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "Umbraco.Web.UI": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:44375;http://localhost:36323",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "SqlServer": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:44375;http://localhost:36323",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__umbracoDbDSN": "Server=(localdb)\\MSSQLLocalDB;Database=kjeldsendev;Integrated Security=true;TrustServerCertificate=True;MultipleActiveResultSets=True",
        "ConnectionStrings__umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient",
        "Engage__Settings__DatabaseConnectionStringName": "umbracoDbDSN",
        "Engage__Settings__Enabled": "true",
        "EngageExtensions__NoColumnStore": "false"
      }
    }
  }
