{
    "$schema": "appsettings-schema.json",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console"
                        }
                    ]
                }
            }
        ]
    },
    // Local runs share the production Azure SQL database (connection string from Key Vault via
    // AddSecrets()). One environment on purpose: this is a dev blog, and breaking it is cheap.
    "Umbraco": {
        "CMS": {
            "Content": {
                "MacroErrors": "Throw"
            },
            "Hosting": {
                "Debug": true
            },
            "Security": {
                "BackOfficeHost": "https://localhost:44375"
            },
            "WebRouting": {
                "UmbracoApplicationUrl": "https://localhost:44375"
            }
        }
    },
    "Nuxt": {
        "Host": "http://localhost:3000"
    },
    "HeadlessBlockPreview": {
        "Host": "http://localhost:3000",
        // Logs why a preview came back empty - wrong selector, upstream error, undeserialisable block.
        "Debug": true,
        // Off locally: the cache keys on the posted JSON for 24h, which hides component edits.
        "EnableOutputCaching": false
    },
    "HeadlessPreview": {
        "Url": "http://localhost:3000/api/init-preview"
    }
}
