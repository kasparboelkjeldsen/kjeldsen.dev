{
    "$schema": "appsettings-schema.json",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console"
                        }
                    ]
                }
            }
        ]
    },
    // Local runs use Umbraco's default SQLite database so the CMS can be upgraded in isolation.
    // "Azure:UseKeyVaultDatabase": false stops AddSecrets() overwriting this with the Azure SQL
    // connection string. Media, licences and keys still come from Key Vault / Azure Blob.
    "ConnectionStrings": {
        "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
        "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite",
        // Engage keeps a write transaction open across a whole migration run while Umbraco needs
        // its own writes to record plan state. SQL Server allows that; SQLite has a single writer
        // per file, so sharing one file deadlocks the boot. Its own file removes the contention.
        "umbracoEngageDbDSN": "Data Source=|DataDirectory|/Umbraco.Engage.sqlite.db;Cache=Private;Foreign Keys=True;Pooling=True",
        "umbracoEngageDbDSN_ProviderName": "Microsoft.Data.Sqlite"
    },
    "Azure": {
        "UseKeyVaultDatabase": false
    },
    "Umbraco": {
        "CMS": {
            "Content": {
                "MacroErrors": "Throw"
            },
            "Hosting": {
                "Debug": true
            },
            "Security": {
                "BackOfficeHost": "https://localhost:44375"
            },
            // Blank SQLite file => no installer wizard. The admin user is created from
            // user secrets (Umbraco:CMS:Unattended:UnattendedUser*) - never commit those.
            "Unattended": {
                "InstallUnattended": true
            },
            "WebRouting": {
                "UmbracoApplicationUrl": "https://localhost:44375"
            }
        }
    },
    "Nuxt": {
        "Host": "http://localhost:3000"
    },
    "HeadlessBlockPreview": {
        "Host": "http://localhost:3000",
        // Logs why a preview came back empty - wrong selector, upstream error, undeserialisable block.
        "Debug": true,
        // Off locally: the cache keys on the posted JSON for 24h, which hides component edits.
        "EnableOutputCaching": false
    },
    "HeadlessPreview": {
        "Url": "http://localhost:3000/api/init-preview"
    },
    // The columnstore Harmony patch rewrites Engage's CreateInitialTables script line by line to
    // strip NCCI blocks, which production needs because the Azure SQL tier has no columnstore.
    // On SQLite it corrupts the script, and it is redundant here anyway: the SQLite dialect drops
    // COLUMNSTORE index statements itself.
    "EngageExtensions": {
        "NoColumnStore": false
    },
    "Engage": {
        "Settings": {
            // Measured trade-off on SQLite, not a preference:
            //   false -> 0 errors, 0 failed statements. Engage still installs completely (the
            //            full migration plan runs and its schema is committed), but from Engage
            //            18 this flag also gates the backoffice section, so no Engage tab.
            //   true  -> Engage tab appears, but Engage's own scheduler starts star-generation
            //            reporting, whose scripts are the one part that cannot be translated to
            //            SQLite. That logs ~30 failed statements per run and starves the
            //            analytics processor of the single write lock. Harmless to the CMS.
            // Left off so the upgrade work has a clean log. Flip to true to use the Engage UI.
            "Enabled": false,
            // Engage resolves its own named connection string; this is the supported seam that
            // lets it live in a separate database from the CMS.
            "DatabaseConnectionStringName": "umbracoEngageDbDSN"
        }
    },
    "uSync": {
        "Settings": {
            // Seeds the blank SQLite database from uSync/v17 on the first boot only, so later
            // boots keep whatever the upgrade migrations did to the local copy.
            "ImportOnFirstBoot": true,
            "ImportAtStartup": "None",
            // Off locally on purpose: an upgrade rewrites datatypes/doctypes as it migrates, and
            // ExportOnSave would silently rewrite the committed uSync folder while it does.
            "ExportOnSave": "None"
        }
    }
}
