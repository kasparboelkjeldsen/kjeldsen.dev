{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.ApplicationInsights"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Umbraco": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Umbraco": {
    "CMS": {
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "OpenApi": {
          // Emits a schema per document/element/media type into the delivery OpenAPI document, so
          // the generated client gets typed `properties` instead of an untyped bag. Off by default
          // in Umbraco 18. This replaces what Umbraco.Community.DeliveryApiExtensions used to do.
          // Must stay identical here and in production - the client is generated against this
          // document, so a difference would mean generating types the live API does not honour.
          "GenerateContentTypeSchemas": true
        }
      },
      "Global": {
        "Id": "3b245cab-cbb5-4a59-b2b1-ed483b079ddf",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false,
        "BackOfficeHost": "https://umbraco.kjeldsen.dev"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://umbraco.kjeldsen.dev"
      },
      "Imaging": {
        "HMACSecretKey": "BYTH6guH4tyzY46cMdCR6vCkEI86cZ2D3C3tNbOBIwxQMMQB0uG2t1ed5h\u002BGFs/bCtCE7EQpiDaX\u002BIskFadk7Q=="
      }
    },
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ContainerName": "kjdevblob"
        }
      }
    }
  },
  "Nuxt": {
    "Host": "https://www.kjeldsen.dev"
  },
  "HeadlessBlockPreview": {
    "Host": "https://kjdev-app-frontend.azurewebsites.net",
    "Api": "/__blockpreview",
    "Selector": "#__preview",
    "Template": "\u003Clink rel=\u0022stylesheet\u0022 href=\u0022/css/cms.css\u0022 /\u003E\u003Cstyle\u003E.__block-preview { background: black; pointer-events: none; padding:10px; }\u003C/style\u003E\u003Cdiv class=\u0022__block-preview\u0022\u003E{{html}}\u003C/div\u003E",
    "Debug": false,
    "EnableOutputCaching": true
  },
  "HeadlessPreview": {
    "Url": "https://kjdev-app-frontend.azurewebsites.net/api/init-preview"
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "Settings"
    }
  },
  "Azure": {
    "KeyVault": "https://kjdevkv.vault.azure.net/"
  },
  "EngageExtensions": {
    "NoColumnStore": true
  },
  "NoteCaptureService": {
    "ContainerName": "memory"
  }
}