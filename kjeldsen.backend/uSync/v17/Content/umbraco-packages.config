          "segment": null,
          "value": "Umbraco Packages"
        }
      ]
    },
    {
      "contentTypeKey": "a34c3bf8-3b46-4f88-9bb0-09b0ed11c963",
      "key": "fbfd46db-1881-4ef0-ba07-7c71f1c3389f",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EAdds a cacheKey field to responses from the Umbraco Delivery API, making it easier for headless consumers to handle caching and invalidation strategies.\u003C/p\u003E\u003Cp\u003EThis package also extends the generated OpenAPI (Swagger) schema to include the new field for improved developer experience and tooling support.\u003C/p\u003E\u003Cp\u003E\u003Ca target=\u0022\u0022 data-router-slot=\u0022disabled\u0022 href=\u0022https://github.com/kraftvaerk/kraftvaerk.umbraco.headless.cachekeys\u0022 title=\u0022github.com\u0022 type=\u0022external\u0022\u003EGo to Github\u003C/a\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "header",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Cache Keys"
        },
        {
          "alias": "iconImage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "1c705764-b7d0-41cc-899d-0722e4667318",
              "mediaKey": "094becca-b131-4aed-bea2-57f48ab833a9",
