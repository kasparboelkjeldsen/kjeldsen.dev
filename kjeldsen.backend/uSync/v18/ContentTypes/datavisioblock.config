<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="b7e4c2a1-6d3f-4e8b-9a5c-1f2d3e4a5b6c" Alias="dataVisioBlock" Level="2">
  <Info>
    <Name>Data Visio Block</Name>
    <Icon>icon-bar-chart color-purple</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A chart drawn from a dataset by the model. Paste the data, say what it should show, pick a form and a model; the chart is written when the page is saved.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>blocks</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
