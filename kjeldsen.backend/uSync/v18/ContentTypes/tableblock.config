<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="c8d9e0f1-2a3b-4c5d-8e6f-7a8b9c0d1e2f" Alias="tableBlock" Level="2">
  <Info>
    <Name>Table Block</Name>
    <Icon>icon-table color-purple</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A table described as JSON: columns, rows, an optional footer row, note and a mobile variant. Format in knowledge/blocks.md.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>blocks</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>c3d4e5f6-0102-4a2b-8c3d-4e5f6a7b8c02</Key>
      <Name>Caption</Name>
      <Alias>caption</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Optional. Shown under the table and read as its accessible name.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c3d4e5f6-0101-4a2b-8c3d-4e5f6a7b8c01</Key>
      <Name>Table</Name>
      <Alias>table</Alias>
      <Definition>2e42b7c8-ba52-4509-b07b-7f5daa8a8cef</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[JSON. Full format in knowledge/blocks.md in the repository. Shape: {"columns": ["Package", {"key": "size", "label": "Size", "align": "right", "mono": true}], "rows": [["Umbraco.Cms", 42], {"Package": "Umbraco.AI", "size": 7}], "footer": ["Total", 49], "note": "optional footnote", "mobile": {"columns": [...], "rows": [...]}}. A column is a label or {key, label, align left|center|right, mono, nowrap, width}. A row is an array in column order or an object keyed by column key. A cell is a string, number, boolean or {text, strong, muted, mono, href, align}; strings may use **bold** and --italic--. Numbers are formatted and right-aligned by themselves. "mobile" is optional and overrides columns and/or rows below 48rem; whatever it leaves out comes from the desktop table (a mobile "columns" subset alone re-projects the desktop rows by key).]]></Description>
      <SortOrder>1</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>e5f6a7b8-0003-4c9d-8e0f-1a2b3c4d5e03</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Group</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>