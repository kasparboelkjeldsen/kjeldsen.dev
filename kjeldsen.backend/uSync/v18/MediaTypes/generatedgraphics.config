      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Optional. What should happen, in what order, with what feel. Left empty, the model picks the scene's natural action.]]></Description>
      <SortOrder>4</SortOrder>
      <Tab Alias="brief">Brief</Tab>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b4d2f0e3-5c6a-4d7b-8e9f-0a1b2c3d4e03</Key>
