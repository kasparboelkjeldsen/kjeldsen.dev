<MediaType Key="7a1f3c52-9b64-4e0a-8c2d-5f6e1d2a9b01" Alias="generatedGraphics" Level="1">
  <Info>
    <Name>Generated Graphics</Name>
    <Icon>icon-wand</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>An illustration drawn by the model from a prompt (and optionally a reference photo), as inline SVG, optionally animated with GSAP. Generated when the item is saved.</Description>
    <AllowAtRoot>True</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <Compositions />
  </Info>
  <GenericProperties>
    <GenericProperty>
      <Key>b4d2f0e3-5c6a-4d7b-8e9f-0a1b2c3d4e04</Key>
      <Name>Animate</Name>
      <Alias>animate</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Also generate a GSAP timeline. It plays once when the graphic scrolls into view, and again on hover or tap.]]></Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="brief">Brief</Tab>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
