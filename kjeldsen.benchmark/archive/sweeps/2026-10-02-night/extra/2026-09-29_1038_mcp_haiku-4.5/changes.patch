@@ -0,0 +1,79 @@
+﻿@using Umbraco.Cms.Web.Common.PublishedModels;
+@using Umbraco.Bench.Umbraco.Models;
+@using Umbraco.Extensions;
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlogPostPage>
+@{
+	Layout = null;
+	ViewData["Title"] = Model?.Title ?? "Blog Post";
+}
+
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>@ViewData["Title"]</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <style>
+        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.6; }
+        .container { max-width: 800px; margin: 0 auto; padding: 0 1rem; }
+        header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem 0; }
+        header a { color: rgba(255,255,255,0.8); text-decoration: none; }
+        header a:hover { color: white; }
+        .post-header { text-align: center; padding: 2rem 0; }
+        .post-title { font-size: 2.5rem; margin: 0; }
+        .post-date { color: #666; font-size: 0.95rem; margin-top: 0.5rem; }
+        .post-image { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin: 2rem 0; }
+        .post-content { font-size: 1.05rem; }
+        .post-content h3 { font-size: 1.5rem; margin-top: 1.5rem; }
+        .post-content ul { margin: 1rem 0; padding-left: 2rem; }
+        .post-content li { margin-bottom: 0.5rem; }
+        .back-link { display: inline-block; margin-top: 2rem; padding: 0.75rem 1.5rem; background: #f0f0f0; border-radius: 4px; text-decoration: none; color: #667eea; font-weight: 500; }
+        .back-link:hover { background: #e0e0e0; }
+    </style>
+</head>
+<body>
+    <header>
+        <div class="container">
+            @{
+                var parentPage = Model?.Parent<BlogFrontPage>();
+                if (parentPage != null)
+                {
+                    <a href="@parentPage.Url()">← Back to Blog</a>
+                }
+            }
+        </div>
+    </header>
+
+    <div class="container">
+        <div class="post-header">
+            <h1 class="post-title">@Model?.Title</h1>
+            @if (Model?.PublishedDate != default)
+            {
+                <p class="post-date">Published on @Model.PublishedDate.ToString("MMMM dd, yyyy")</p>
+            }
+        </div>
+
+        @if (Model?.FeaturedImage != null)
+        {
+            var imageUrl = Model.FeaturedImage.GetCropUrl(width: 800, height: 400);
+            <img src="@imageUrl" alt="@Model.Title" class="post-image" />
+        }
+
+        @if (Model?.Content != null)
+        {
+            <div class="post-content">
+                @Html.Raw(Model.Content)
+            </div>
+        }
+
+        @{
+            var parent = Model?.Parent<BlogFrontPage>();
+            if (parent != null)
+            {
+                <a href="@parent.Url()" class="back-link">← Back to Blog</a>
+            }
+        }
+    </div>
+</body>
+</html>
