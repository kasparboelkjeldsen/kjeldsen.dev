+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Blog - Umbraco MCP Demo</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body class="bg-gray-50">
+    <nav class="bg-white shadow-md">
+        <div class="max-w-4xl mx-auto px-6 py-4">
+            <a href="/" class="text-2xl font-bold text-blue-600">Umbraco Blog</a>
+        </div>
+    </nav>
+
+    <main>
+        @RenderBody()
+    </main>
+
+    <footer class="bg-gray-800 text-white mt-16 py-8">
+        <div class="max-w-4xl mx-auto px-6 text-center">
+            <p>&copy; 2026 Blog powered by Umbraco MCP</p>
+            <p class="text-sm text-gray-400 mt-2">Demonstrating the power of Model-Context Protocol</p>
+        </div>
+    </footer>
+
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</body>
+</html>