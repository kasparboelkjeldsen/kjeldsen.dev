diff --git a/Umbraco.Bench.Umbraco/Views/Partials/BlogPost.cshtml b/Umbraco.Bench.Umbraco/Views/Partials/BlogPost.cshtml
new file mode 100644
index 0000000..c0f518e
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Partials/BlogPost.cshtml
@@ -0,0 +1,20 @@
+@model Umbraco.Bench.Umbraco.Models.BlogPost
+
+<article class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
+    <div class="h-64 overflow-hidden bg-gray-200">
+        @if (Model.FeaturedImage != null)
+        {
+            <img src="@Model.FeaturedImage.GetCropUrl(width: 600, height: 400)"
+                 alt="@Model.Title"
+                 class="w-full h-full object-cover" />
+        }
+    </div>
+    <div class="p-6">
+        <h3 class="text-2xl font-bold text-gray-900 mb-2">@Model.Title</h3>
+        <p class="text-gray-600 mb-4">@Model.Excerpt</p>
+        <a href="@Model.Url()"
+           class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
+            Read More →
+        </a>
+    </div>
+</article>
diff --git a/Umbraco.Bench.Umbraco/Views/Partials/BlogPostDetail.cshtml b/Umbraco.Bench.Umbraco/Views/Partials/BlogPostDetail.cshtml
new file mode 100644
index 0000000..9279c1e
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Partials/BlogPostDetail.cshtml
@@ -0,0 +1,33 @@
+@inherits UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogPost>
+
+<div class="max-w-4xl mx-auto">
+    <article class="bg-white rounded-lg shadow-lg p-8">
+        <header class="mb-8">
+            <h1 class="text-4xl font-bold text-gray-900 mb-2">@Model.Title</h1>
+            <p class="text-gray-600 italic">@Model.Excerpt</p>
+        </header>
+
+        @if (Model.FeaturedImage != null)
+        {
+            <div class="mb-8">
+                <img src="@Model.FeaturedImage.GetCropUrl(width: 800, height: 500)"
+                     alt="@Model.Title"
+                     class="w-full rounded-lg" />
+            </div>
+        }
+
+        <div class="prose prose-lg max-w-none mb-8">
+            @Html.Raw(Model.Content)
+        </div>
+
+        <div class="border-t pt-6">
+            @{
+                var parent = Model.AncestorOrSelf<Umbraco.Bench.Umbraco.Models.BlogFrontPage>();
+                var backUrl = parent != null ? parent.Url() : "/";
+            }
+            <a href="@backUrl" class="text-blue-600 hover:text-blue-700">
+                ← Back to Blog
+            </a>
+        </div>
+    </article>
+</div>