diff --git a/Umbraco.Bench.Umbraco/Views/BlogFrontPage.cshtml b/Umbraco.Bench.Umbraco/Views/BlogFrontPage.cshtml
new file mode 100644
index 0000000..551445a
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/BlogFrontPage.cshtml
@@ -0,0 +1,29 @@
+@inherits UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogFrontPage>
+@{
+    var blogPosts = Model.Children<Umbraco.Bench.Umbraco.Models.BlogPost>().Where(p => p.IsVisible());
+}
+
+<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
+    <header class="bg-white shadow-md">
+        <div class="max-w-6xl mx-auto px-6 py-12">
+            <h1 class="text-4xl font-bold text-gray-900">@Model.Heading</h1>
+            <p class="text-lg text-gray-600 mt-2">@Model.Subheading</p>
+        </div>
+    </header>
+
+    <main class="max-w-6xl mx-auto px-6 py-12">
+        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
+            @foreach (var post in blogPosts)
+            {
+                <partial name="BlogPost" model="post" />
+            }
+        </div>
+
+        @if (!blogPosts.Any())
+        {
+            <div class="text-center py-12">
+                <p class="text-gray-600 text-lg">No blog posts yet. Check back soon!</p>
+            </div>
+        }
+    </main>
+</div>
