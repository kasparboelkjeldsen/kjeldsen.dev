+﻿@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Web.Common.PublishedModels
+@inherits UmbracoViewPage<BlogFrontPage>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html>
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>@Model.Value("title")</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+</head>
+<body class="bg-gray-50">
+    <div class="min-h-screen">
+        <header class="bg-white shadow">
+            <div class="max-w-6xl mx-auto px-6 py-12">
+                <h1 class="text-4xl font-bold text-gray-900">@Model.Value("title")</h1>
+                <p class="text-xl text-gray-600 mt-4">Exploring the power of Model Context Protocol</p>
+            </div>
+        </header>
+
+        <main class="max-w-6xl mx-auto px-6 py-12">
+            <div class="grid gap-8 md:grid-cols-2">
+                @foreach (var post in Model.Children<BlogPost>())
+                {
+                    <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
+                        @if (post.FeaturedImage != null)
+                        {
+                            <div class="h-64 overflow-hidden bg-gray-200">
+                                <img src="@post.FeaturedImage.GetCropUrl(width: 600, height: 400)"
+                                     alt="@post.Title"
+                                     class="w-full h-full object-cover" />
+                            </div>
+                        }
+                        <div class="p-6">
+                            <h2 class="text-2xl font-bold text-gray-900 mb-3">
+                                <a href="@post.Url()" class="hover:text-blue-600">@post.Title</a>
+                            </h2>
+                            <p class="text-gray-600 mb-4">
+                                Published @post.CreateDate.ToString("MMMM d, yyyy")
+                            </p>
+                            <a href="@post.Url()" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
+                                Read More
+                            </a>
+                        </div>
+                    </article>
+                }
+            </div>
+        </main>
+    </div>
+</body>
+</html>
