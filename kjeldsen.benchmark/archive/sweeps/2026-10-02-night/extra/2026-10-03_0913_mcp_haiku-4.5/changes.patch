+﻿@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Web.Common.PublishedModels
+@inherits UmbracoViewPage<BlogPost>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html>
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>@Model.Title</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+</head>
+<body class="bg-gray-50">
+    <div class="min-h-screen">
+        <header class="bg-white shadow">
+            <div class="max-w-3xl mx-auto px-6 py-6">
+                <a href="/" class="text-blue-600 hover:text-blue-700 mb-4 inline-block">← Back to Blog</a>
+                <h1 class="text-4xl font-bold text-gray-900">@Model.Title</h1>
+                <p class="text-gray-600 mt-2">Published @Model.CreateDate.ToString("MMMM d, yyyy")</p>
+            </div>
+        </header>
+
+        @if (Model.FeaturedImage != null)
+        {
+            <div class="h-96 overflow-hidden bg-gray-200">
+                <img src="@Model.FeaturedImage.GetCropUrl(width: 1200, height: 400)"
+                     alt="@Model.Title"
+                     class="w-full h-full object-cover" />
+            </div>
+        }
+
+        <main class="max-w-3xl mx-auto px-6 py-12">
+            <article class="prose prose-lg max-w-none">
+                @Html.Raw(Model.Content?.ToString() ?? "")
+            </article>
+        </main>
+    </div>
+</body>
+</html>
