      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Building Intelligent Content Systems with MCP"
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "featuredImage",
          "value": [
            {
              "key": "55217fe1-3deb-4e52-ab9d-106e3186e81c",
              "mediaKey": "55217fe1-3deb-4e52-ab9d-106e3186e81c",
              "mediaTypeAlias": "Image",
              "crops": [],
