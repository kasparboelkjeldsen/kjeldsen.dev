      "name": "Why MCP Is Awesome: Standardized Content Integration",
      "path": "WWW / Blog / Why MCP Is Awesome: Standardized Content Integration",
      "docTypeId": "9d2a506d-1e34-4945-b3a3-59f62ce80abb",
