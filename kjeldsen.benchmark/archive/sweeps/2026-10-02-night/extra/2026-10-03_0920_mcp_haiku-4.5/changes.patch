@@ -0,0 +1,42 @@
+﻿@inherits UmbracoViewPage<BlogPost>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html>
+<head>
+    <title>@Model.Value("title")</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body>
+    <nav class="bg-gray-100 p-4">
+        <div class="container mx-auto">
+            <a href="/" class="text-blue-600 hover:text-blue-800">← Back to Blog</a>
+        </div>
+    </nav>
+
+    <article class="container mx-auto p-8 max-w-2xl">
+        @if (Model.HasValue("featuredImage"))
+        {
+            var image = Model.Value<IPublishedContent>("featuredImage");
+            @if (image != null)
+            {
+                <img src="@image.Url()" alt="@Model.Value("title")" class="w-full mb-8 rounded-lg" />
+            }
+        }
+
+        <h1 class="text-5xl font-bold mb-4">@Model.Value("title")</h1>
+
+        @if (Model.HasValue("excerpt"))
+        {
+            <p class="text-xl text-gray-700 mb-8 font-semibold">@Model.Value("excerpt")</p>
+        }
+
+        <div class="prose prose-lg max-w-none">
+            @Html.Raw(Model.Value("content"))
+        </div>
+    </article>
+
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</body>
+</html>
