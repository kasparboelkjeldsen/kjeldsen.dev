+﻿@inherits UmbracoViewPage<BlogFrontPage>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html>
+<head>
+    <title>@Model.Value("pageTitle")</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body>
+    <div class="container mx-auto p-8">
+        <h1 class="text-4xl font-bold mb-4">@Model.Value("pageTitle")</h1>
+        @if (Model.HasValue("pageDescription"))
+        {
+            <p class="text-lg text-gray-600 mb-8">@Model.Value("pageDescription")</p>
+        }
+
+        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
+            @{
+                var blogPosts = Model.Children<BlogPost>();
+            }
+            @foreach (var post in blogPosts)
+            {
+                <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
+                    @if (post.HasValue("featuredImage"))
+                    {
+                        var image = post.Value<IPublishedContent>("featuredImage");
+                        @if (image != null)
+                        {
+                            <div class="relative h-48 overflow-hidden bg-gray-200">
+                                <img src="@image.Url()" alt="@post.Value("title")" class="w-full h-full object-cover" />
+                            </div>
+                        }
+                    }
+                    <div class="p-6">
+                        <h2 class="text-2xl font-bold mb-2">
+                            <a href="@post.Url()" class="text-blue-600 hover:text-blue-800">@post.Value("title")</a>
+                        </h2>
+                        @if (post.HasValue("excerpt"))
+                        {
+                            <p class="text-gray-600 mb-4">@post.Value("excerpt")</p>
+                        }
+                        <a href="@post.Url()" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
+                            Read More
+                        </a>
+                    </div>
+                </article>
+            }
+        </div>
+    </div>
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</body>
+</html>
