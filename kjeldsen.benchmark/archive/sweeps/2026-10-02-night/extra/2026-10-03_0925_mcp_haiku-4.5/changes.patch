+﻿@inherits UmbracoViewPage<BlogPost>
+@{
+    Layout = "layout.cshtml";
+}
+
+<article class="container mx-auto px-4 py-12 max-w-3xl">
+    <header class="mb-8">
+        <h1 class="text-4xl font-bold mb-4">@Model.Name</h1>
+        <div class="flex items-center justify-between text-gray-600 border-b pb-4">
+            <div>
+                <span class="font-semibold">By @Model.Value("author")</span>
+                @{
+                    var pubDate = Model.Value<DateTime?>("publishDate");
+                    if (pubDate.HasValue)
+                    {
+                        <time class="ml-4">@pubDate.Value.ToString("MMMM d, yyyy")</time>
+                    }
+                }
+            </div>
+        </div>
+    </header>
+
+    @{
+        var imageValue = Model.Value("featuredImage");
+        if (imageValue != null)
+        {
+            var image = Model.Value<IPublishedContent>("featuredImage");
+            <figure class="my-8">
+                <img src="@image.GetCropUrl(800, 450)" alt="Featured image" class="w-full rounded-lg" />
+                <figcaption class="text-center text-gray-600 mt-2 text-sm">Featured image</figcaption>
+            </figure>
+        }
+    }
+
+    <div class="prose prose-lg max-w-none mb-12">
+        @Html.Raw(Model.Value("content"))
+    </div>
+
+    <footer class="border-t pt-8">
+        <a href="/" class="inline-block bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">Back to Blog</a>
+    </footer>
+</article>
