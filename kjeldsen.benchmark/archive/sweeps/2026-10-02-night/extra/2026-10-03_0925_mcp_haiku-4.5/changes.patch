+﻿@inherits UmbracoViewPage<BlogFrontPage>
+@{
+    Layout = "layout.cshtml";
+}
+
+<div class="container mx-auto px-4 py-12">
+    <h1 class="text-4xl font-bold mb-6">@Model.Value("headline")</h1>
+    
+    <div class="prose prose-lg mb-12">
+        @Html.Raw(Model.Value("content"))
+    </div>
+
+    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
+        @foreach (var child in Model.Children<BlogPost>())
+        {
+            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
+                @{
+                    var image = child.Value<IPublishedContent>("featuredImage");
+                    if (image != null)
+                    {
+                        <img src="@image.GetCropUrl(400, 250)" alt="Featured image" class="w-full h-64 object-cover" />
+                    }
+                }
+                
+                <div class="p-6">
+                    @{
+                        var pubDate = child.Value<DateTime?>("publishDate");
+                        if (pubDate.HasValue)
+                        {
+                            <time class="text-gray-500 text-sm">@pubDate.Value.ToString("MMM d, yyyy")</time>
+                        }
+                    }
+                    <h2 class="text-2xl font-bold mt-2 mb-4"><a href="@child.Url()" class="hover:text-blue-600">@child.Name</a></h2>
+                    <p class="text-gray-700 mb-4">By @child.Value("author")</p>
+                    <a href="@child.Url()" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Read More</a>
+                </div>
+            </article>
+        }
+    </div>
+</div>
