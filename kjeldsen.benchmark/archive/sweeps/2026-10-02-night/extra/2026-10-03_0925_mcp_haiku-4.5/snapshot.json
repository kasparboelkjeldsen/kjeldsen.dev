          "segment": null,
          "alias": "featuredImage",
          "value": [
            {
              "key": "b2c3d4e5-f6a7-4809-b0c1-d2e3f4a5b6c7",
              "mediaKey": "c0a2b4c8-57c8-4e85-8709-cc1199689e4b",
