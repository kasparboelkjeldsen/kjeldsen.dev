    {
      "id": "7565b47d-1c3f-4d2a-ace4-631ec8a0de3f",
      "name": "MCP for Content Modeling",
      "path": "WWW / Blog / MCP for Content Modeling",
      "docTypeId": "26847ce8-1e82-4b3a-9a20-ce37d8f08b8a",
