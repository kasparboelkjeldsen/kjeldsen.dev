@@ -0,0 +1,34 @@
+﻿@using ContentModels = Umbraco.Bench.Umbraco.Models;
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.BlogFrontPage>
+@{
+	Layout = "_Layout.cshtml";
+}
+
+<div class="container mx-auto px-4 py-16">
+	<div class="mb-12">
+		<h1 class="text-5xl font-bold mb-4">@Model.Title</h1>
+		<p class="text-xl text-gray-600">@Model.Subtitle</p>
+	</div>
+
+	<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
+		@foreach (var post in Model.Children<ContentModels.BlogPostPage>().OrderByDescending(p => p.PublishDate))
+		{
+			<div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
+				@if (post.FeaturedImage is not null)
+				{
+					<div class="h-48 overflow-hidden bg-gray-200">
+						<img src="@post.FeaturedImage.GetCropUrl(width: 400, height: 300)" alt="@post.Title" class="w-full h-full object-cover" />
+					</div>
+				}
+				<div class="p-6">
+					<h2 class="text-2xl font-bold mb-2">@post.Title</h2>
+					<div class="text-sm text-gray-500 mb-4">@post.PublishDate.ToString("MMMM d, yyyy")</div>
+					<div class="text-gray-700 mb-4">@Html.Raw(post.Excerpt)</div>
+					<a href="@post.Url()" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
+						Read More
+					</a>
+				</div>
+			</div>
+		}
+	</div>
+</div>
