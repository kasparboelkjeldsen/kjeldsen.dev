+﻿@using ContentModels = Umbraco.Bench.Umbraco.Models;
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.BlogPostPage>
+@{
+	Layout = "_Layout.cshtml";
+}
+
+<article class="container mx-auto px-4 py-16 max-w-3xl">
+	<div class="mb-8">
+		<h1 class="text-5xl font-bold mb-4">@Model.Title</h1>
+		<div class="flex items-center text-gray-600 text-sm space-x-4">
+			<span>@Model.PublishDate.ToString("MMMM d, yyyy")</span>
+		</div>
+	</div>
+
+	@if (Model.FeaturedImage is not null)
+	{
+		<div class="mb-8 rounded-lg overflow-hidden shadow-lg">
+			<img src="@Model.FeaturedImage.GetCropUrl(width: 800, height: 450)" alt="@Model.Title" class="w-full h-auto" />
+		</div>
+	}
+
+	<div class="prose prose-lg max-w-none mb-8">
+		<div class="text-gray-700 leading-relaxed">
+			@Html.Raw(Model.Content)
+		</div>
+	</div>
+
+	<div class="border-t pt-8">
+		<a href="/" class="text-blue-600 hover:text-blue-800 font-semibold">
+			&larr; Back to Blog
+		</a>
+	</div>
+</article>
