+<!DOCTYPE html>
+<html lang="en">
+<head>
+	<meta charset="UTF-8">
+	<meta name="viewport" content="width=device-width, initial-scale=1.0">
+	<title>@ViewBag.Title - Blog</title>
+	<link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+	<script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+	<style>
+		[v-cloak] { display: none; }
+	</style>
+</head>
+<body class="bg-gray-50">
+	<nav class="bg-white shadow-sm">
+		<div class="container mx-auto px-4 py-4">
+			<a href="/" class="text-2xl font-bold text-blue-600">Blog</a>
+		</div>
+	</nav>
+
+	<main>
+		@RenderBody()
+	</main>
+
+	<footer class="bg-gray-800 text-white mt-16">
+		<div class="container mx-auto px-4 py-8">
+			<p class="text-center text-gray-400">
+				&copy; 2026 Blog. Exploring Model Context Protocol and Web Innovation.
+			</p>
+		</div>
+	</footer>
+</body>
+</html>
diff --git a/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml b/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml
