    {
      "id": "d748cd29-8fb0-479f-98b6-fe8bf997a483",
      "name": "MCP turns tools into teammates",
      "path": "WWW / MCP Field Notes / MCP turns tools into teammates",
      "docTypeId": "97eaa1f9-c5f2-4641-a024-95352319a19f",
      "templateId": "778d82ac-8a08-4f0f-b4f7-351e4630a119",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "e3111111-1111-4111-8111-111111111111",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "e3222222-2222-4222-8222-222222222222",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "00fe897f-b004-49c3-bf82-4b733d0ab298",
                "key": "e3111111-1111-4111-8111-111111111111",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "MCP turns tools into teammates"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "intro",
                    "value": "The best interfaces are the ones that let you stay in the flow of the work."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "f2111111-1111-4111-8111-111111111111",
                        "mediaKey": "9839c7a3-aa21-450c-8849-d6e0330a0825",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "f8376009-7dd5-433e-8eee-b7609051194f",
                "key": "e3222222-2222-4222-8222-222222222222",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<p>MCP is awesome because it gives AI systems a shared language for working with real tools and real context. Instead of copying fragments between windows, an assistant can inspect the project, understand the available operations, and make a useful change where the work actually lives.</p><p>That changes the feeling of software work. The model can ask the system for the shape of the content, use the project’s conventions, and verify the result immediately. The conversation stays focused on outcomes while the protocol handles the handoff.</p><p>In short: MCP makes capability discoverable, composable, and close to the source of truth.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "e3111111-1111-4111-8111-111111111111",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "e3222222-2222-4222-8222-222222222222",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
