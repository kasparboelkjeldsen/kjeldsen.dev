      "template": "blogPost"
    },
    {
      "id": "ac863820-f70b-4820-a958-d42b735609c5",
      "name": "MCP makes complexity feel approachable",
      "path": "WWW / MCP Field Notes / MCP makes complexity feel approachable",
      "docTypeId": "97eaa1f9-c5f2-4641-a024-95352319a19f",
      "templateId": "778d82ac-8a08-4f0f-b4f7-351e4630a119",
