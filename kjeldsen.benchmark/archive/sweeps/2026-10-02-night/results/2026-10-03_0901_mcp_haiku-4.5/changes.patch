@@ -0,0 +1,43 @@
+﻿@inherits UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogPostPage>
+@using Umbraco.Cms.Web.Common.PublishedModels
+
+@{
+    Layout = "layout.cshtml";
+}
+
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@Model.Title</title>
+    <meta name="description" content="@Model.Excerpt" />
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body class="bg-white">
+    <div class="max-w-4xl mx-auto px-4 py-12">
+        <a href="@Model.Parent().Url()!" class="text-blue-600 hover:text-blue-800 mb-6 inline-block">
+            ← Back to Blog
+        </a>
+
+        <article>
+            <header class="mb-12">
+                <h1 class="text-4xl font-bold mb-4">@Model.Title</h1>
+                <p class="text-xl text-gray-600">@Model.Excerpt</p>
+            </header>
+
+            <div class="prose prose-lg max-w-none">
+                @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+            </div>
+        </article>
+
+        <nav class="mt-16 pt-8 border-t border-gray-200">
+            <a href="@Model.Parent().Url()!" class="text-blue-600 hover:text-blue-800 font-medium">
+                ← Back to all posts
+            </a>
+        </nav>
+    </div>
+
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</body>
+</html>