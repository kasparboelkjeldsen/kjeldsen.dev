+﻿@inherits UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogFrontPage>
+@using Umbraco.Cms.Web.Common.PublishedModels
+
+@{
+    Layout = "layout.cshtml";
+}
+
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@Model.Title</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body class="bg-white">
+    <div class="max-w-4xl mx-auto px-4 py-12">
+        <h1 class="text-4xl font-bold mb-2">@Model.Title</h1>
+        <p class="text-gray-600 mb-12">Exploring the power of MCP and modern content management</p>
+
+        <div class="grid gap-8">
+            @foreach (var post in Model.Children<Umbraco.Bench.Umbraco.Models.BlogPostPage>())
+            {
+                <article class="border-l-4 border-blue-500 pl-6 py-4">
+                    <h2 class="text-2xl font-bold mb-2">
+                        <a href="@post.Url()!" class="text-blue-600 hover:text-blue-800">
+                            @post.Title
+                        </a>
+                    </h2>
+                    <p class="text-gray-600 mb-4">@post.Excerpt</p>
+                    <a href="@post.Url()!" class="inline-block text-blue-600 hover:text-blue-800 font-medium">
+                        Read more →
+                    </a>
+                </article>
+            }
+        </div>
+    </div>
+
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</body>
+</html>
