      "values": [
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Dispatches on building with AI — starting with why the Model Context Protocol is worth paying attention to."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "c9f4d3fc-0431-447c-8d86-04dd410b0ba0",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "81735e7e-f082-44b2-9ee1-50544695fc59",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "87607f02-d4ad-469c-b44c-fd587877caf4",
                "key": "c9f4d3fc-0431-447c-8d86-04dd410b0ba0",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<h2>Welcome</h2><p>This blog is itself a demonstration of the Umbraco MCP server: every document type, block, template, and post below was created by an AI agent talking to Umbraco's management API — no admin-UI clicks, no bespoke code. Start with the two posts below on why the Model Context Protocol is worth paying attention to.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "a81ac966-1450-4676-a7e6-ee0d2b629e24",
                "key": "81735e7e-f082-44b2-9ee1-50544695fc59",
