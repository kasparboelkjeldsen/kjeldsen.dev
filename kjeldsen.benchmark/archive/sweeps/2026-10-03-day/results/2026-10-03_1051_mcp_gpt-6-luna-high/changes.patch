diff --git a/Umbraco.Bench.Umbraco/Views/blogHomePage.cshtml b/Umbraco.Bench.Umbraco/Views/blogHomePage.cshtml
new file mode 100644
index 0000000..c30dc57
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogHomePage.cshtml
@@ -0,0 +1,25 @@
+@inherits UmbracoViewPage<BlogHomePage>
+<!doctype html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>@Model.Name · The MCP Notebook</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</head>
+<body class="bg-stone-50 text-stone-900 antialiased">
+    <header class="border-b border-stone-200 bg-white">
+        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
+            <a href="/" class="font-semibold tracking-tight">The MCP Notebook</a>
+            <span class="text-sm text-stone-500">Notes on connected tools</span>
+        </div>
+    </header>
+    <main class="mx-auto max-w-6xl px-6 py-12 md:py-20">
+        @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+    </main>
+    <footer class="border-t border-stone-200">
+        <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-stone-500">Built with Umbraco and the Model Context Protocol.</div>
+    </footer>
+</body>
+</html>
diff --git a/Umbraco.Bench.Umbraco/Views/blogPostPage.cshtml b/Umbraco.Bench.Umbraco/Views/blogPostPage.cshtml
new file mode 100644
index 0000000..95ad406
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogPostPage.cshtml
@@ -0,0 +1,36 @@
+@inherits UmbracoViewPage<BlogPostPage>
+<!doctype html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>@Model.Name · The MCP Notebook</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</head>
+<body class="bg-stone-50 text-stone-900 antialiased">
+    <header class="border-b border-stone-200 bg-white">
+        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
+            <a href="/" class="font-semibold tracking-tight">The MCP Notebook</a>
+            <a href="/" class="text-sm text-stone-600 hover:text-stone-950">All articles</a>
+        </div>
+    </header>
+    <main class="mx-auto max-w-3xl px-6 py-12 md:py-20">
+        <a href="/" class="mb-8 inline-flex text-sm font-medium text-sky-800 hover:text-sky-950">← Back to all articles</a>
+        <article>
+            <header class="mb-10 border-b border-stone-200 pb-8">
+                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-sky-800">The MCP Notebook</p>
+                <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">@Model.Name</h1>
+                @if (!string.IsNullOrWhiteSpace(Model.Summary))
+                {
+                    <p class="mt-5 text-xl leading-8 text-stone-600">@Model.Summary</p>
+                }
+            </header>
+            @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+        </article>
+    </main>
+    <footer class="border-t border-stone-200">
+        <div class="mx-auto max-w-3xl px-6 py-8 text-sm text-stone-500"><a href="/" class="hover:text-stone-900">The MCP Notebook</a></div>
+    </footer>
+</body>
+</html>
