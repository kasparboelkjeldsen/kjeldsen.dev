diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostList/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostList/Default.cshtml
new file mode 100644
index 0000000..1068bc8
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostList/Default.cshtml
@@ -0,0 +1,27 @@
+@model BlogPostListViewModel
+<section aria-labelledby="latest-articles">
+    <div class="mb-6 flex items-end justify-between border-b border-stone-300 pb-4">
+        <h2 id="latest-articles" class="text-2xl font-semibold tracking-tight">Latest articles</h2>
+        <span class="text-sm text-stone-500">@Model.Posts.Count articles</span>
+    </div>
+    @if (Model.Posts.Count == 0)
+    {
+        <p class="text-stone-600">New articles are on the way.</p>
+    }
+    else
+    {
+        <div class="grid gap-5 md:grid-cols-2">
+            @foreach (var post in Model.Posts)
+            {
+                <article class="flex min-h-64 flex-col rounded-2xl border border-stone-200 bg-white p-7 shadow-sm">
+                    <p class="text-sm text-stone-500">@post.PublishedAt.ToString("MMMM d, yyyy")</p>
+                    <h3 class="mt-4 text-2xl font-semibold leading-snug tracking-tight">
+                        <a class="hover:text-sky-800" href="@post.Url">@post.Title</a>
+                    </h3>
+                    <p class="mt-3 leading-7 text-stone-600">@post.Summary</p>
+                    <a class="mt-auto pt-6 text-sm font-semibold text-sky-800 hover:text-sky-950" href="@post.Url">Read article <span aria-hidden="true">→</span></a>
+                </article>
+            }
+        </div>
+    }
+</section>
