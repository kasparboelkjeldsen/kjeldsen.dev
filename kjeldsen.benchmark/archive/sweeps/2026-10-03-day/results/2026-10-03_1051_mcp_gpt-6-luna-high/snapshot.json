    {
      "id": "ae860774-a6c7-4eb8-b24d-8d15be3840de",
      "name": "MCP Turns Tool Sprawl into One Conversation",
      "path": "WWW / The MCP Notebook / MCP Turns Tool Sprawl into One Conversation",
      "docTypeId": "3dd42688-79a5-4c55-a253-4049c99a27cf",
      "templateId": "64d2f16c-cf29-4497-866f-cf7552053126",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "summary",
          "value": "MCP gives AI assistants a consistent way to discover tools and use them with the context of the work at hand."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "51054e79-b55a-4d29-ac26-436302b0c4cb",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "4a9ad7d8-241a-450f-8c6b-bed1b4b9e66a",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "595e7a13-1085-45a1-89e1-c1ca51d159cd",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "f96d3f44-70e6-46d4-b23d-733cfa09aded",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "d3ff4f20-d399-45b6-a9c0-3324ee4ba4ed",
                "key": "51054e79-b55a-4d29-ac26-436302b0c4cb",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "6b8901a4-ea80-48c6-80ac-18e72a6d91aa",
                        "mediaKey": "8e55eb7b-6bbd-4822-b063-1ae29ecf905b",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Code on screen — Chris Ried / Unsplash"
                  }
                ]
              },
              {
                "contentTypeKey": "22ff0177-1b93-43c6-80df-ae972b700ce4",
                "key": "4a9ad7d8-241a-450f-8c6b-bed1b4b9e66a",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "A shared doorway for tools"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "Every useful tool has its own interface, permissions, and way of describing what it can do. MCP gives those tools a common doorway. An assistant can discover available capabilities and call them in a consistent way, without a custom integration for every new pairing.\n\nThat makes the ecosystem easier to extend: add a server for a new system and the assistant can work with it through the same protocol."
                  }
                ]
              },
              {
                "contentTypeKey": "22ff0177-1b93-43c6-80df-ae972b700ce4",
                "key": "595e7a13-1085-45a1-89e1-c1ca51d159cd",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "Context travels with the work"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "A browser, a repository, and a content management system each hold useful pieces of context. MCP lets an assistant connect to them during one task, so it can inspect the project, make an informed change, and verify the result in the system that owns it.\n\nThe payoff is less copying and pasting, fewer brittle one-off bridges, and a clearer path from a question to a useful action."
                  }
                ]
              },
              {
                "contentTypeKey": "d3ff4f20-d399-45b6-a9c0-3324ee4ba4ed",
                "key": "f96d3f44-70e6-46d4-b23d-733cfa09aded",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "2acfe013-f8b9-4457-bd48-6e3ee40ecf63",
                        "mediaKey": "856b0598-4089-4bf5-b281-1ffe38b94112",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Network lines and dots — Conny Schneider / Unsplash"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
