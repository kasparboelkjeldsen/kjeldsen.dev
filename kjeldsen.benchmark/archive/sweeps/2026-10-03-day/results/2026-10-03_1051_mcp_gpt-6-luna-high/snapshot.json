    {
      "id": "2abf9b67-b229-4467-967c-7f747b00396a",
      "name": "From Prompt to Published Page: MCP in Practice",
      "path": "WWW / The MCP Notebook / From Prompt to Published Page: MCP in Practice",
      "docTypeId": "3dd42688-79a5-4c55-a253-4049c99a27cf",
      "templateId": "64d2f16c-cf29-4497-866f-cf7552053126",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "summary",
          "value": "A connected assistant can inspect a site, shape its content model, publish real content, and render it through the site's own conventions."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "2cf10b0e-7521-4f79-95f3-d4ade050e3ab",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "9bcf0eaf-1b35-4834-a825-6bc9d759fb01",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "e5a35d42-0f94-4087-bd24-5a119e56d65a",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "d3ff4f20-d399-45b6-a9c0-3324ee4ba4ed",
                "key": "2cf10b0e-7521-4f79-95f3-d4ade050e3ab",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "dc12d255-967e-4867-b043-24384ce5a616",
                        "mediaKey": "1646437a-06f3-4314-a252-351901308fe1",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Hands fitting puzzle pieces — Vardan Papikyan / Unsplash"
                  }
                ]
              },
              {
                "contentTypeKey": "22ff0177-1b93-43c6-80df-ae972b700ce4",
                "key": "9bcf0eaf-1b35-4834-a825-6bc9d759fb01",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "Start with the shape of the work"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "A connected workflow begins by reading the site's rules and inspecting its existing document types. That gives the assistant the information it needs to create a small, suitable model instead of guessing at the system's structure.\n\nWith MCP, the model and content can then be created through the same management API a person would use. The content lives in Umbraco, with real media references and published variants."
                  }
                ]
              },
              {
                "contentTypeKey": "22ff0177-1b93-43c6-80df-ae972b700ce4",
                "key": "e5a35d42-0f94-4087-bd24-5a119e56d65a",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "A useful handoff between systems"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "The work does not stop at saving a document. MCP can confirm that the content was accepted, while the project's normal build and rendering pipeline turns it into a page. Each tool has a clear role: Umbraco stores and publishes, the application renders, and the assistant coordinates the steps.\n\nThat makes the result reviewable. Editors can find the content in the backoffice, developers can keep the source in version control, and visitors see the same published site the team maintains."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "2cf10b0e-7521-4f79-95f3-d4ade050e3ab",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "9bcf0eaf-1b35-4834-a825-6bc9d759fb01",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "e5a35d42-0f94-4087-bd24-5a119e56d65a",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/from-prompt-to-published-page-mcp-in-practice/"
      ],
