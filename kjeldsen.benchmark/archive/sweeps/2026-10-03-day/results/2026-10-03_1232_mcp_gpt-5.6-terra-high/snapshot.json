                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "c8c7f4d0-fb2b-4b8c-aac4-dab66d105104",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "86f7431d-068b-4719-943f-4a0b22e24a8e",
                "key": "a0d5d8ca-2f2a-4e06-970b-19ccd5edb103",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "MCP Makes Local Development Feel Like a Conversation"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "summary",
                    "value": "With a local MCP server, content modeling, media, and verification stay close to the application they change."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "10000000-0000-4000-8000-000000000002",
                        "mediaKey": "68182d2c-997e-4524-9199-d35063e204f4",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "0890d6e9-79b2-4bcc-9229-69a3b2cdc6f9",
                "key": "c8c7f4d0-fb2b-4b8c-aac4-dab66d105104",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "Small loops, strong evidence"
                  },
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<p>Local MCP tools are especially compelling because they make the feedback loop short. Create a document type, publish content, and read the stored document back without leaving the project context.</p><p>The result is a calmer development experience: fewer manual clicks, less fragile glue code, and a crisp audit trail of the operations that shaped the site.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
