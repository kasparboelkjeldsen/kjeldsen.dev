    {
      "id": "ab267cbd-e4bb-47cc-9f6e-ec16564895ef",
      "name": "MCP Makes Local Development Better",
      "path": "WWW / MCP Field Notes / MCP Makes Local Development Better",
      "docTypeId": "93c1781e-57f1-452b-88fd-9fd9a2539a61",
      "templateId": "a7f679cd-7182-42d8-a836-a6abfec172c6",
