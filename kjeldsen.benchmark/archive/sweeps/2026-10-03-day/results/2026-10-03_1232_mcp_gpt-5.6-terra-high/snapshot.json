    {
      "id": "e7b72ba1-39b1-45a2-8fec-81dcdc937176",
      "name": "Why MCP Is Awesome",
      "path": "WWW / MCP Field Notes / Why MCP Is Awesome",
      "docTypeId": "93c1781e-57f1-452b-88fd-9fd9a2539a61",
      "templateId": "a7f679cd-7182-42d8-a836-a6abfec172c6",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "4a4cf814-a6a9-479a-8bd9-954d1f8d4101",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "2e712982-e834-4b42-8a1b-0465b5f8e102",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "86f7431d-068b-4719-943f-4a0b22e24a8e",
                "key": "4a4cf814-a6a9-479a-8bd9-954d1f8d4101",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "Why MCP Is Awesome: Context Meets Action"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "summary",
                    "value": "MCP gives assistants the context and tools to move from an answer to a useful, verifiable result."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "10000000-0000-4000-8000-000000000001",
                        "mediaKey": "c90fa286-a026-4746-b5f8-e4cbea4a227f",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "0890d6e9-79b2-4bcc-9229-69a3b2cdc6f9",
                "key": "2e712982-e834-4b42-8a1b-0465b5f8e102",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "A shared operating context"
                  },
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<p>Model Context Protocol turns a scattered toolkit into a coherent conversation. An assistant can discover the capabilities it has, inspect the state that matters, and take narrowly scoped action through the same interface.</p><p>That changes the useful unit of work from a pasted instruction to a repeatable workflow. Tools can return structured results, so the next decision is grounded in what actually happened rather than a hopeful guess.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "4a4cf814-a6a9-479a-8bd9-954d1f8d4101",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "2e712982-e834-4b42-8a1b-0465b5f8e102",
