                  "contentKey": "62a5a68c-7ee2-4cff-9f81-09238a80982c",
                  "settingsKey": "9415fbd0-aec4-4d54-902a-b35431ad48b4"
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "266507cb-d837-494b-bb0f-5f145c1b93e0",
                "key": "493212f2-170d-4e05-8bf3-9a2b81ece3bf",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heroHeading",
                    "value": "MCP makes content operations conversational"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "heroIntro",
                    "value": "The protocol gives editors and developers a shared language for moving from idea to published content."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "heroImage",
                    "value": [
                      {
                        "key": "7c983f9e-1cd3-44c9-8139-584139f3b2ab",
                        "mediaKey": "f8e784f2-26fa-4636-a0c1-8d530d0a058b",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "cc28d8a0-819b-44ff-8ea5-3127adfb60d2",
                "key": "62a5a68c-7ee2-4cff-9f81-09238a80982c",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<h2>Less plumbing, more publishing</h2><p>MCP is awesome because it turns a pile of disconnected tools into a conversation. An agent can inspect the model, understand the available fields, and make a focused change without inventing a parallel content pipeline.</p><p>That makes the work easier to explain and easier to audit. The content still lives in Umbraco, the schema stays explicit, and the next useful action is always close at hand.</p><p><strong>Credit:</strong> Code on screen by Chris Ried via Unsplash.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
