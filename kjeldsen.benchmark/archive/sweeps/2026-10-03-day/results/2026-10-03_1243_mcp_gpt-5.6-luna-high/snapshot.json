      "path": "WWW / MCP Blog / MCP makes content operations conversational",
      "docTypeId": "97cdd503-f7a6-4ea8-a039-ef7e9a1cf87f",
      "templateId": "31ade749-9816-44a2-a412-6f0fcae31250",
