                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "266507cb-d837-494b-bb0f-5f145c1b93e0",
                "key": "c39be36d-b47a-4137-9116-694ead2335dc",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heroHeading",
                    "value": "MCP turns Umbraco into a creative teammate"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "heroIntro",
                    "value": "A good protocol makes the distance between a question and a useful change wonderfully small."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "heroImage",
                    "value": [
                      {
                        "key": "a91c3b93-f599-420b-8a65-9728c749ced5",
                        "mediaKey": "06720332-e55b-4e6b-bb84-0de72f177362",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "cc28d8a0-819b-44ff-8ea5-3127adfb60d2",
                "key": "a46bdeaf-5201-47e9-a3cb-8bdc20d456ee",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<h2>A shared protocol creates momentum</h2><p>MCP is awesome because it gives the creative part of web work a dependable set of handles. Ask for the available content types, inspect a document, place a block, and verify the result — each step is visible and grounded in the site’s actual model.</p><p>That changes the feeling of the work. Instead of translating between a brief, an API, and a backoffice screen, the team can stay focused on the story while the system keeps the structure honest.</p><p><strong>Credit:</strong> Connected structure by Alina Grubnyak via Unsplash.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
