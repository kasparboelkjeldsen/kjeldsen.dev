{
  "name": "kjeldsen-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nuxi dev",
    "build": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nuxi build",
    "preview": "nuxi preview",
    "start": "node .output/server/index.mjs",
    "gen": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-ts",
    "gen:engage": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-ts -f openapi-ts.engage.config.ts",
    "build:cms-css": "tailwindcss -i app/assets/css/main.css -o ../kjeldsen.backend/wwwroot/css/cms.css",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "h3-compression": "^1.1.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.0"
  }
}
